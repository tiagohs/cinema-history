        <item name="colorSurfaceContainerLow">@color/awards_surface</item>
        <item name="colorSurfaceContainerHigh">@color/awards_surface_high</item>
        <item name="colorOutline">@color/awards_outline</item>
        <item name="colorPrimary">@color/awards_gold</item>
        <item name="colorOnPrimary">@color/awards_on_gold</item>
        <item name="colorSecondary">@color/awards_gold</item>
