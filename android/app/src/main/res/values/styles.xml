    <!-- ===================== Componentes ===================== -->

    <!--
        Cartões: MaterialCardView M3 (elevated), mas com o raio/elevação padrão do CardView antigo
        para não alterar os layouts que não definem esses valores. Layouts novos definem o próprio raio.
    -->
    <style name="Widget.CinemaHistory.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">2dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Cartões novos da Home (cantos M3 grandes, sem sombra pesada) -->
    <style name="Widget.CinemaHistory.CardView.Home" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="shapeAppearance">?attr/shapeAppearanceCornerLarge</item>
    </style>

    <style name="Widget.CinemaHistory.CardView.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="shapeAppearance">?attr/shapeAppearanceCornerLarge</item>
    </style>

    <!-- Toolbars: M3, mas o título segue a cor do tema da AppBar (branco nas barras escuras). -->
    <style name="Widget.CinemaHistory.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.CinemaHistory.TitleLarge</item>
        <item name="titleTextColor">?android:attr/textColorPrimary</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.CinemaHistory.TitleSmall</item>
        <item name="subtitleTextColor">?android:attr/textColorSecondary</item>
    </style>

    <!--
        AppBarLayout/CollapsingToolbar: o M3 troca o fundo por colorSurface, remove a sombra,
        força inset no topo e pinta o título de colorOnSurface. Como quase todas as telas usam
        cabeçalho com imagem atrás da status bar, mantemos o comportamento dos widgets Design.
    -->
    <style name="Widget.CinemaHistory.AppBarLayout" parent="Widget.Design.AppBarLayout">
        <!-- O padrão é ?attr/colorPrimary, que no tema escuro fica claro: as barras continuam pretas. -->
        <item name="android:background">@color/colorPrimary</item>
    </style>

    <style name="Widget.CinemaHistory.CollapsingToolbar" parent="Widget.Design.CollapsingToolbar">
        <item name="scrimAnimationDuration">?attr/motionDurationMedium2</item>
    </style>

    <style name="Widget.CinemaHistory.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabTextAppearance">@style/AppTheme.TextAppearance</item>
    </style>

    <!-- Botões da Home sobre imagem escura -->
    <style name="Widget.CinemaHistory.Button.OnImage" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/md_white_1000</item>
        <item name="android:textColor">@color/md_black_1000</item>
        <item name="iconTint">@color/md_black_1000</item>
        <item name="rippleColor">@color/home_ripple_on_light</item>
    </style>

    <style name="Widget.CinemaHistory.Button.OnImage.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/md_white_1000</item>
        <item name="iconTint">@color/md_white_1000</item>
        <item name="strokeColor">@color/home_outline_on_image</item>
        <item name="rippleColor">@color/home_ripple_on_dark</item>
    </style>

