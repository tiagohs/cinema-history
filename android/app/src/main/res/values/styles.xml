<resources>

    <!--
        Tema base do app em Material Design 3.

        O app tem identidade própria (preto e branco, cores por era, Proxima Nova/Oswald), então o
        esquema de cores M3 é mapeado a partir das cores antigas (primary preto, accent azul) e as
        superfícies ficam neutras (sem o tom lilás padrão do baseline M3).
    -->
    <style name="Base.AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <!-- Cores (esquema M3) -->
        <item name="colorPrimary">@color/md_black_1000</item>
        <item name="colorOnPrimary">@color/md_white_1000</item>
        <item name="colorPrimaryContainer">@color/md_grey_200</item>
        <item name="colorOnPrimaryContainer">@color/md_black_1000</item>
        <item name="colorPrimaryInverse">@color/md_blue_200</item>

        <item name="colorSecondary">@color/md_blue_500</item>
        <item name="colorOnSecondary">@color/md_white_1000</item>
        <item name="colorSecondaryContainer">@color/md_blue_50</item>
        <item name="colorOnSecondaryContainer">@color/md_blue_900</item>

        <item name="colorTertiary">@color/oscar</item>
        <item name="colorOnTertiary">@color/md_black_1000</item>
        <item name="colorTertiaryContainer">@color/md_amber_50</item>
        <item name="colorOnTertiaryContainer">@color/md_brown_900</item>

        <item name="colorError">@color/md_red_700</item>
        <item name="colorOnError">@color/md_white_1000</item>
        <item name="colorErrorContainer">@color/md_red_50</item>
        <item name="colorOnErrorContainer">@color/md_red_900</item>

        <item name="android:colorBackground">@color/md_white_1000</item>
        <item name="colorOnBackground">@color/md_black_1000</item>
        <item name="colorSurface">@color/md_white_1000</item>
        <item name="colorOnSurface">@color/md_black_1000</item>
        <item name="colorSurfaceVariant">@color/md_grey_200</item>
        <item name="colorOnSurfaceVariant">@color/md_grey_700</item>
        <item name="colorSurfaceInverse">@color/home_surface_inverse</item>
        <item name="colorOnSurfaceInverse">@color/md_white_1000</item>
        <item name="colorSurfaceBright">@color/md_white_1000</item>
        <item name="colorSurfaceDim">@color/md_grey_300</item>
        <item name="colorSurfaceContainerLowest">@color/md_white_1000</item>
        <item name="colorSurfaceContainerLow">@color/md_white_1000</item>
        <item name="colorSurfaceContainer">@color/md_grey_100</item>
        <item name="colorSurfaceContainerHigh">@color/md_grey_200</item>
        <item name="colorSurfaceContainerHighest">@color/md_grey_300</item>
        <item name="colorOutline">@color/md_grey_500</item>
        <item name="colorOutlineVariant">@color/md_grey_300</item>
        <item name="elevationOverlayEnabled">false</item>

        <!-- Atributos legados (AppCompat). colorPrimaryDark é lido por SystemBarsInsets. -->
        <item name="colorPrimaryDark">@color/md_black_1000</item>
        <item name="colorAccent">@color/md_blue_500</item>

        <!-- Tipografia: Proxima Nova no texto e Oswald nos títulos grandes -->
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="fontFamily">@font/proxima_nova_regular</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.CinemaHistory.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.CinemaHistory.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.CinemaHistory.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.CinemaHistory.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.CinemaHistory.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.CinemaHistory.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.CinemaHistory.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.CinemaHistory.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.CinemaHistory.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.CinemaHistory.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.CinemaHistory.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.CinemaHistory.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.CinemaHistory.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.CinemaHistory.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.CinemaHistory.LabelSmall</item>

        <!-- Componentes: versões M3, ajustadas para não quebrar os layouts personalizados -->
        <item name="materialCardViewStyle">@style/Widget.CinemaHistory.CardView</item>
        <item name="toolbarStyle">@style/Widget.CinemaHistory.Toolbar</item>
        <item name="appBarLayoutStyle">@style/Widget.CinemaHistory.AppBarLayout</item>
        <item name="collapsingToolbarLayoutStyle">@style/Widget.CinemaHistory.CollapsingToolbar</item>
        <item name="tabStyle">@style/Widget.CinemaHistory.TabLayout</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowContentTransitions">true</item>
    </style>

    <style name="AppTheme" parent="Base.AppTheme" />

    <!-- Tela "Sobre" (android-about-page): mantém a action bar escura de antes. -->
    <style name="AboutTheme" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/md_black_1000</item>
        <item name="colorOnPrimary">@color/md_white_1000</item>
        <item name="colorPrimaryDark">@color/md_black_1000</item>
        <item name="colorAccent">@color/md_blue_500</item>
        <item name="colorSecondary">@color/md_blue_500</item>
        <item name="colorSurface">@color/md_white_1000</item>
        <item name="colorOnSurface">@color/md_black_1000</item>
        <item name="colorSurfaceContainerLow">@color/md_white_1000</item>
        <item name="android:colorBackground">@color/md_white_1000</item>
        <item name="actionBarStyle">@style/Widget.CinemaHistory.ActionBar.Dark</item>
        <item name="actionBarTheme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>

        <item name="android:fontFamily">@font/proxima_nova_regular</item>
    </style>

    <style name="Widget.CinemaHistory.ActionBar.Dark" parent="Widget.Material3.Light.ActionBar.Solid">
        <item name="background">@color/md_black_1000</item>
        <item name="titleTextStyle">@style/TextAppearance.CinemaHistory.ActionBarTitle</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="TextAppearance.CinemaHistory.ActionBarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/md_white_1000</item>
        <item name="android:fontFamily">@font/proxima_nova_bold</item>
        <item name="fontFamily">@font/proxima_nova_bold</item>
    </style>

    <!-- Abas (prêmios etc.) -->
    <style name="AppTheme.TextAppearance" parent="TextAppearance.Material3.TitleMedium">
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_size_zeplin_26pt</item>
        <item name="android:fontFamily">@font/proxima_nova_bold</item>
        <item name="fontFamily">@font/proxima_nova_bold</item>
    </style>

    <!--
        Telas que desenham atrás da status bar (imagem no topo).
        MANTER android:windowTranslucentStatus: SystemBarsInsets e StatusBarScrim dependem dele.
    -->
    <style name="AppTheme.AppThemeWithStatusTransparent">
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <style name="AppTheme.AppThemeWithStatusWhite">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="colorPrimaryDark">@color/md_black_1000</item>
    </style>

    <style name="AppTheme.AppThemeWithStatusBarSemiTransarent">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="colorPrimaryDark">@color/md_black_1000</item>
    </style>

    <style name="AppTheme.TimelineStyle">
        <item name="colorPrimaryDark">@color/md_yellow_A700</item>
    </style>

    <style name="AppTheme.Expansed">
        <item name="android:textColor">@android:color/transparent</item>
        <item name="android:fontFamily">@font/proxima_nova_bold</item>
    </style>

    <style name="AppTheme.Collalpsed">
        <item name="android:fontFamily">@font/proxima_nova_bold</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3.Light" />

    <style name="ToolBarStandard" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="android:elevation">0dp</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@android:color/white</item>
        <item name="android:actionMenuTextAppearance">@style/ToolBarMenuItem</item>
        <item name="android:actionBarStyle">@style/ActionBarStyle</item>
    </style>

    <style name="ToolBarTransparent" parent="ToolBarStandard">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="ActionBarStyle" parent="android:style/Widget.Holo.ActionBar">
        <item name="android:titleTextStyle">@style/ToolBarTitle</item>
    </style>

    <style name="ToolBarMenuItem" parent="android:style/TextAppearance.Holo.Widget.ActionBar.Menu">
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="fontFamily">@font/proxima_nova_regular</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="FastScrollItemStyle">
        <item name="android:fontFamily">@font/proxima_nova_bold</item>
        <item name="fontFamily">@font/proxima_nova_bold</item>
        <item name="android:textSize">@dimen/text_size_zeplin_28pt</item>
    </style>

    <style name="ToolBarTitle" parent="android:style/TextAppearance.Holo.Widget.ActionBar.Title">
        <item name="android:fontFamily">@font/proxima_nova_bold</item>
        <item name="fontFamily">@font/proxima_nova_bold</item>
    </style>

    <style name="AppTheme.Overlay" parent="AppTheme">
        <item name="colorPrimary">@android:color/transparent</item>
    </style>

    <style name="SplashScreenTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/md_black_1000</item>
        <item name="colorPrimaryDark">@color/md_black_1000</item>
        <item name="android:windowBackground">@drawable/background_splash_screen</item>
    </style>

    <style name="TextAppearance.ExpandedTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/oswald_bold</item>
        <item name="fontFamily">@font/oswald_bold</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.CollapsedTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/oswald_bold</item>
        <item name="fontFamily">@font/oswald_bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- ===================== Tipografia M3 ===================== -->

    <style name="TextAppearance.CinemaHistory.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/oswald_bold</item>
        <item name="fontFamily">@font/oswald_bold</item>
    </style>

    <style name="TextAppearance.CinemaHistory.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/oswald_bold</item>
        <item name="fontFamily">@font/oswald_bold</item>
    </style>

    <style name="TextAppearance.CinemaHistory.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/oswald_bold</item>
        <item name="fontFamily">@font/oswald_bold</item>
    </style>

    <style name="TextAppearance.CinemaHistory.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/oswald_bold</item>
        <item name="fontFamily">@font/oswald_bold</item>
    </style>

    <style name="TextAppearance.CinemaHistory.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/oswald_bold</item>
        <item name="fontFamily">@font/oswald_bold</item>
    </style>

    <style name="TextAppearance.CinemaHistory.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/oswald_bold</item>
        <item name="fontFamily">@font/oswald_bold</item>
    </style>

    <style name="TextAppearance.CinemaHistory.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/proxima_nova_bold</item>
        <item name="fontFamily">@font/proxima_nova_bold</item>
    </style>

    <style name="TextAppearance.CinemaHistory.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/proxima_nova_bold</item>
        <item name="fontFamily">@font/proxima_nova_bold</item>
    </style>

    <style name="TextAppearance.CinemaHistory.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/proxima_nova_bold</item>
        <item name="fontFamily">@font/proxima_nova_bold</item>
    </style>

    <style name="TextAppearance.CinemaHistory.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="fontFamily">@font/proxima_nova_regular</item>
    </style>

    <style name="TextAppearance.CinemaHistory.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="fontFamily">@font/proxima_nova_regular</item>
    </style>

    <style name="TextAppearance.CinemaHistory.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="fontFamily">@font/proxima_nova_regular</item>
    </style>

    <style name="TextAppearance.CinemaHistory.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/proxima_nova_bold</item>
        <item name="fontFamily">@font/proxima_nova_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="TextAppearance.CinemaHistory.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/proxima_nova_bold</item>
        <item name="fontFamily">@font/proxima_nova_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="TextAppearance.CinemaHistory.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/proxima_nova_bold</item>
        <item name="fontFamily">@font/proxima_nova_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- Rótulo pequeno em caixa alta (sobretítulo/"overline") usado na Home -->
    <style name="TextAppearance.CinemaHistory.Overline" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/proxima_nova_bold</item>
        <item name="fontFamily">@font/proxima_nova_bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <!-- ===================== Componentes ===================== -->

    <!--
        Cartões: MaterialCardView M3 (elevated), mas com o raio/elevação padrão do CardView antigo
        para não alterar os layouts que não definem esses valores. Layouts novos definem o próprio raio.
    -->
    <style name="Widget.CinemaHistory.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">2dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Cartões novos da Home (cantos M3 grandes, sem sombra pesada) -->
    <style name="Widget.CinemaHistory.CardView.Home" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="shapeAppearance">?attr/shapeAppearanceCornerLarge</item>
    </style>

    <style name="Widget.CinemaHistory.CardView.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="shapeAppearance">?attr/shapeAppearanceCornerLarge</item>
    </style>

    <!-- Toolbars: M3, mas o título segue a cor do tema da AppBar (branco nas barras escuras). -->
    <style name="Widget.CinemaHistory.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.CinemaHistory.TitleLarge</item>
        <item name="titleTextColor">?android:attr/textColorPrimary</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.CinemaHistory.TitleSmall</item>
        <item name="subtitleTextColor">?android:attr/textColorSecondary</item>
    </style>

    <!--
        AppBarLayout/CollapsingToolbar: o M3 troca o fundo por colorSurface, remove a sombra,
        força inset no topo e pinta o título de colorOnSurface. Como quase todas as telas usam
        cabeçalho com imagem atrás da status bar, mantemos o comportamento dos widgets Design.
    -->
    <style name="Widget.CinemaHistory.AppBarLayout" parent="Widget.Design.AppBarLayout" />

    <style name="Widget.CinemaHistory.CollapsingToolbar" parent="Widget.Design.CollapsingToolbar">
        <item name="scrimAnimationDuration">?attr/motionDurationMedium2</item>
    </style>

    <style name="Widget.CinemaHistory.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabTextAppearance">@style/AppTheme.TextAppearance</item>
    </style>

    <!-- Botões da Home sobre imagem escura -->
    <style name="Widget.CinemaHistory.Button.OnImage" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/md_white_1000</item>
        <item name="android:textColor">@color/md_black_1000</item>
        <item name="iconTint">@color/md_black_1000</item>
        <item name="rippleColor">@color/home_ripple_on_light</item>
    </style>

    <style name="Widget.CinemaHistory.Button.OnImage.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/md_white_1000</item>
        <item name="iconTint">@color/md_white_1000</item>
        <item name="strokeColor">@color/home_outline_on_image</item>
        <item name="rippleColor">@color/home_ripple_on_dark</item>
    </style>

</resources>
