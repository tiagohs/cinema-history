<resources>

    <!--
        Tema base do app em Material Design 3, com versão clara e escura (DayNight).
        A escolha (Claro / Escuro / Padrão do sistema) fica em Configurações e é aplicada com
        AppCompatDelegate.setDefaultNightMode (App.onCreate e SettingPreferenceFragment).

        O app tem identidade própria (preto e branco, cores por era, Proxima Nova/Oswald), então o
        esquema de cores M3 é mapeado a partir das cores antigas (primary preto, accent azul) e as
        superfícies ficam neutras (sem o tom lilás padrão do baseline M3).
    -->
    <style name="Base.AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Cores (esquema M3). Valores claros em values/colors_theme.xml; escuros em values-night/. -->
        <item name="colorPrimary">@color/theme_primary</item>
        <item name="colorOnPrimary">@color/theme_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/theme_primary_inverse</item>

        <item name="colorSecondary">@color/theme_secondary</item>
        <item name="colorOnSecondary">@color/theme_on_secondary</item>
        <item name="colorSecondaryContainer">@color/theme_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/theme_on_secondary_container</item>

        <item name="colorTertiary">@color/theme_tertiary</item>
        <item name="colorOnTertiary">@color/theme_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/theme_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/theme_on_tertiary_container</item>

        <item name="colorError">@color/theme_error</item>
        <item name="colorOnError">@color/theme_on_error</item>
        <item name="colorErrorContainer">@color/theme_error_container</item>
        <item name="colorOnErrorContainer">@color/theme_on_error_container</item>

        <item name="android:colorBackground">@color/theme_background</item>
        <item name="colorOnBackground">@color/theme_on_background</item>
        <item name="colorSurface">@color/theme_surface</item>
        <item name="colorOnSurface">@color/theme_on_surface</item>
        <item name="colorSurfaceVariant">@color/theme_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/theme_on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/theme_surface_inverse</item>
        <item name="colorOnSurfaceInverse">@color/theme_on_surface_inverse</item>
        <item name="colorSurfaceBright">@color/theme_surface_bright</item>
        <item name="colorSurfaceDim">@color/theme_surface_dim</item>
        <item name="colorSurfaceContainerLowest">@color/daynight_background</item>
        <item name="colorSurfaceContainerLow">@color/daynight_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/daynight_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/daynight_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/daynight_surface_container_highest</item>
        <item name="colorOutline">@color/theme_outline</item>
        <item name="colorOutlineVariant">@color/theme_outline_variant</item>
        <item name="elevationOverlayEnabled">false</item>

        <!-- Atributos legados (AppCompat). colorPrimaryDark é lido por SystemBarsInsets. -->
        <item name="colorPrimaryDark">@color/md_black_1000</item>
        <item name="colorAccent">@color/theme_secondary</item>

        <!-- Tipografia: Proxima Nova no texto e Oswald nos títulos grandes -->
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="fontFamily">@font/proxima_nova_regular</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.CinemaHistory.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.CinemaHistory.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.CinemaHistory.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.CinemaHistory.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.CinemaHistory.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.CinemaHistory.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.CinemaHistory.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.CinemaHistory.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.CinemaHistory.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.CinemaHistory.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.CinemaHistory.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.CinemaHistory.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.CinemaHistory.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.CinemaHistory.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.CinemaHistory.LabelSmall</item>

        <!-- Componentes: versões M3, ajustadas para não quebrar os layouts personalizados -->
        <item name="materialCardViewStyle">@style/Widget.CinemaHistory.CardView</item>
        <item name="toolbarStyle">@style/Widget.CinemaHistory.Toolbar</item>
        <item name="appBarLayoutStyle">@style/Widget.CinemaHistory.AppBarLayout</item>
        <item name="collapsingToolbarLayoutStyle">@style/Widget.CinemaHistory.CollapsingToolbar</item>
        <item name="tabStyle">@style/Widget.CinemaHistory.TabLayout</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowContentTransitions">true</item>
    </style>

    <style name="AppTheme" parent="Base.AppTheme" />

    <!-- Tela "Sobre" (android-about-page): mantém a action bar escura de antes. -->
    <style name="AboutTheme" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/md_black_1000</item>
