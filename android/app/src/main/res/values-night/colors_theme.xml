<?xml version="1.0" encoding="utf-8"?>
<!--
    Esquema de cores M3 do AppTheme no modo escuro.

    - Superfícies neutras em camadas (fundo #121212; cartões e containers mais claros conforme a
      elevação) — ver helpers/res/values-night/colors_daynight.xml.
    - primary: a identidade preto e branco do app se inverte (primary quase branco, onPrimary escuro),
      para botões, seleção, switches e indicadores continuarem visíveis.
    - secondary: azul 200 (tom claro), com contraste AA sobre as superfícies escuras.
    - Cabeçalhos, faixas e cartões pretos de propósito continuam pretos (usam md_black_1000).
-->
<resources>
    <color name="theme_primary">#FFE6E6E6</color>
    <color name="theme_on_primary">#FF1A1A1A</color>
    <color name="theme_primary_container">#FF3A3A3A</color>
    <color name="theme_on_primary_container">#FFE6E6E6</color>
    <color name="theme_primary_inverse">#FF1976D2</color>

    <color name="theme_secondary">#FF90CAF9</color>
    <color name="theme_on_secondary">#FF0D2A47</color>
    <color name="theme_secondary_container">#FF0D47A1</color>
    <color name="theme_on_secondary_container">#FFBBDEFB</color>

    <color name="theme_tertiary">#FFE0C98A</color>
    <color name="theme_on_tertiary">#FF2B2205</color>
    <color name="theme_tertiary_container">#FF4A3C12</color>
    <color name="theme_on_tertiary_container">#FFFFECB3</color>

    <color name="theme_error">#FFF2B8B5</color>
    <color name="theme_on_error">#FF601410</color>
    <color name="theme_error_container">#FF8C1D18</color>
    <color name="theme_on_error_container">#FFF9DEDC</color>

    <color name="theme_surface_variant">#FF424242</color>
    <color name="theme_surface_inverse">#FFE6E6E6</color>
    <color name="theme_on_surface_inverse">#FF1F1F1F</color>
    <color name="theme_surface_bright">#FF383838</color>
    <color name="theme_surface_dim">#FF121212</color>
    <color name="theme_outline">#FF8E8E8E</color>
</resources>
