<?xml version="1.0" encoding="utf-8"?>
<!-- Aba "Indicados e vencedores": seletor de ano fixo no topo + fileiras de categorias. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/awards_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/yearBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/awards_year_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/decadeButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/award_choose_decade"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:textColor="@color/awards_on_surface"
            app:icon="@drawable/ic_awards_expand_16dp"
            app:iconGravity="end"
            app:iconPadding="2dp"
            app:iconTint="@color/awards_gold"
            tools:text="Anos 2020" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/yearList"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="4dp"
            android:paddingEnd="@dimen/awards_screen_padding"
            tools:listitem="@layout/adapter_award_year_pill"
            tools:orientation="horizontal" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pageContentList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="32dp"
            tools:listitem="@layout/adapter_award_category_row" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/yearLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="48dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/awards_gold"
            app:trackColor="@color/awards_surface_high" />

        <LinearLayout
            android:id="@+id/yearError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/award_year_error"
                android:textColor="@color/awards_on_surface_variant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/yearRetry"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/award_retry"
                android:textColor="@color/awards_gold" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
