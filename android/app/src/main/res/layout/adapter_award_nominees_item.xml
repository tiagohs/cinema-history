<?xml version="1.0" encoding="utf-8"?>
<!--
    Cartão de indicado (filme ou pessoa). O tamanho do pôster é definido no ViewHolder pelo tipo
    (vencedor = maior). Sem imagem/ID do TMDB, aparece um "cartaz" gerado com as iniciais e o nome.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nomineeRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:clickable="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/posterFrame"
        android:layout_width="@dimen/awards_card_width"
        android:layout_height="@dimen/awards_card_height"
        android:clipChildren="false">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/posterCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/awards_surface_high"
            app:cardCornerRadius="@dimen/awards_card_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/awards_gold"
            app:strokeWidth="0dp">

            <FrameLayout
                android:id="@+id/placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible"
                tools:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/awards_placeholder_shade" />

                <TextView
                    android:id="@+id/placeholderInitials"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="28dp"
                    android:alpha="0.35"
                    android:fontFamily="@font/oswald_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/awards_on_surface"
                    android:textSize="52sp"
                    tools:text="AB" />

                <TextView
                    android:id="@+id/placeholderName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_margin="10dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/oswald_regular"
                    android:gravity="center"
                    android:maxLines="3"
                    android:textColor="@color/awards_on_surface"
                    android:textSize="14sp"
                    tools:text="Nome do filme sem pôster" />

            </FrameLayout>

            <ImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <View
                android:id="@+id/posterShade"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_gravity="bottom"
                android:background="@drawable/awards_card_shade"
                android:visibility="gone" />

            <TextView
                android:id="@+id/winnerMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="8dp"
                android:background="@drawable/awards_winner_badge"
                android:drawablePadding="4dp"
                android:fontFamily="@font/oswald_regular"
                android:gravity="center_vertical"
                android:letterSpacing="0.08"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="@string/award_winner_badge"
                android:textAllCaps="true"
                android:textColor="@color/awards_on_gold"
                android:textSize="11sp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_awards_trophy_16dp"
                app:drawableTint="@color/awards_on_gold"
                tools:visibility="visible" />

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <TextView
        android:id="@+id/nomineesTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/awards_on_surface"
        android:textSize="13sp"
        tools:text="Uma Batalha Após a Outra" />

    <TextView
        android:id="@+id/nomineesSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/awards_on_surface_muted"
        android:textSize="12sp"
        tools:text="Paul Thomas Anderson" />

</LinearLayout>
