<?xml version="1.0" encoding="utf-8"?>
<!-- Um benefício do apoio: ícone em círculo + título + descrição (tela de apoio, onboarding). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/benefitIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/background_support_icon_circle"
        android:backgroundTint="?attr/colorTertiaryContainer"
        android:importantForAccessibility="no"
        android:padding="10dp"
        app:tint="?attr/colorOnTertiaryContainer"
        tools:src="@drawable/ic_support_headphones_24" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/benefitTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="Narração em áudio de todos os capítulos" />

        <TextView
            android:id="@+id/benefitSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Em português. Inglês e espanhol em breve." />
    </LinearLayout>
</LinearLayout>
