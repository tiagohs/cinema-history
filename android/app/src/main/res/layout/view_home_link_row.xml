<?xml version="1.0" encoding="utf-8"?>
<!-- Linha de lista M3 (ícone, título, descrição e seta) usada na seção "Mais" da Home. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linkRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/linkIcon"
        android:layout_width="@dimen/home_link_icon_container"
        android:layout_height="@dimen/home_link_icon_container"
        android:background="@drawable/background_home_link_icon"
        android:importantForAccessibility="no"
        android:padding="9dp"
        app:tint="@color/md_white_1000"
        tools:srcCompat="@drawable/ic_library_books" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/linkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Glossário" />

        <TextView
            android:id="@+id/linkDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Termos e definições no mundo do cinema." />

    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_navigate_next_black_24dp"
        app:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
