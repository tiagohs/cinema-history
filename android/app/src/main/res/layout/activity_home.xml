<?xml version="1.0" encoding="utf-8"?>
<!--
    Home (Material 3).
    - Topo: destaque grande da História do Cinema ("Continue lendo" ou o capítulo mais recente),
      desenhado atrás da status bar (tema AppThemeWithStatusTransparent).
    - Carrossel M3 com todas as eras.
    - Grade com as outras áreas (homecontent.json) e lista com Glossário, Referências, Configurações e Sobre.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:background="@color/md_black_1000"
        android:alpha="0"
        android:theme="@style/AppTheme.AppBarOverlay"
        app:elevation="0dp"
        tools:alpha="1">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            app:contentScrim="@color/md_black_1000"
            app:statusBarScrim="@color/md_black_1000"
            app:titleEnabled="false"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <FrameLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_hero_min_height"
                android:fitsSystemWindows="true"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.6">

                <ImageView
                    android:id="@+id/heroImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fitsSystemWindows="true"
                    android:scaleType="centerCrop"
                    android:importantForAccessibility="no"
                    tools:src="@drawable/img_chinatown" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/home_hero_top_scrim"
                    android:layout_gravity="top"
                    android:background="@drawable/background_degrade_top" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="bottom"
                    android:layout_marginTop="@dimen/home_hero_scrim_offset"
                    android:background="@drawable/background_home_scrim_bottom" />

                <!-- Tablets: o texto do destaque não atravessa a imagem toda (ls_hero_text_max_width). -->
                <com.tiagohs.cinema_history.presentation.views.MaxWidthLinearLayout
                    android:id="@+id/heroContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    app:ls_maxWidth="@dimen/ls_hero_text_max_width"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/home_hero_content_padding"
                    android:paddingEnd="@dimen/home_hero_content_padding"
                    android:paddingBottom="@dimen/home_hero_content_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/heroPart"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/background_home_pill"
                            android:backgroundTint="@color/md_red_500"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="@color/md_white_1000"
                            tools:text="Parte 08" />

                        <TextView
                            android:id="@+id/heroKicker"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.CinemaHistory.Overline"
                            android:textColor="@color/home_text_on_image_secondary"
                            tools:text="Continue lendo" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/heroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/oswald_bold"
                        android:includeFontPadding="false"
                        android:lineSpacingMultiplier="1.05"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textColor="@color/md_white_1000"
                        android:textSize="@dimen/home_hero_title_size"
                        tools:text="De 2020 até hoje" />

                    <TextView
                        android:id="@+id/heroOverline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/history_cinema_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/md_white_1000" />

                    <TextView
                        android:id="@+id/heroDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/home_text_on_image_secondary"
                        tools:text="Os visionários, inventores, sonhadores. As experimentações e descobertas de Georges Mélies..." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/heroPrimaryButton"
                            style="@style/Widget.CinemaHistory.Button.OnImage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:icon="@drawable/ic_open_book_white_24dp"
                            app:iconGravity="textStart"
                            tools:text="Continuar" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/heroSecondaryButton"
                            style="@style/Widget.CinemaHistory.Button.OnImage.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/home_all_eras" />

                    </LinearLayout>

                </com.tiagohs.cinema_history.presentation.views.MaxWidthLinearLayout>

            </FrameLayout>

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:fitsSystemWindows="false"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/AppTheme.PopupOverlay">

                <ImageView
                    android:layout_width="@dimen/home_logo_size"
                    android:layout_height="@dimen/home_logo_size"
                    android:contentDescription="@string/description_logo_app"
                    app:srcCompat="@drawable/ic_logo_light" />

            </com.google.android.material.appbar.MaterialToolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:alpha="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/home_section_spacing"
            android:paddingBottom="@dimen/home_section_spacing">

            <!-- ===== História do Cinema: eras ===== -->

            <LinearLayout
                android:id="@+id/erasHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/home_screen_padding"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_section_eras_title"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/erasSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Uma viagem pela história do cinema em 8 partes" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/erasSeeAll"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_see_all" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/erasCarousel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_era_carousel_height"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/home_screen_padding"
                android:paddingEnd="@dimen/home_screen_padding"
                app:layoutManager="com.google.android.material.carousel.CarouselLayoutManager"
                tools:listitem="@layout/adapter_home_era" />

            <!-- Citação da era em destaque (mesma citação usada na apresentação da era).
                 Tablets: largura máxima (ls_list_max_width), alinhada ao título das seções. -->
            <com.tiagohs.cinema_history.presentation.views.MaxWidthFrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ls_maxWidth="@dimen/ls_list_max_width">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quoteCard"
                style="@style/Widget.CinemaHistory.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/home_screen_padding"
                android:layout_marginTop="@dimen/home_section_spacing"
                android:layout_marginEnd="@dimen/home_screen_padding"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/quoteIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:importantForAccessibility="no"
                        android:rotation="180"
                        app:srcCompat="@drawable/ic_quote_top_24dp"
                        app:tint="@color/md_red_500" />

                    <TextView
                        android:id="@+id/quoteText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/proxima_nova_regular_italic"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_size_zeplin_32pt"
                        tools:text="Tenho a sensação de que não estamos mais no Kansas." />

                    <TextView
                        android:id="@+id/quoteAuthor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/oswald_bold"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_size_zeplin_26pt"
                        tools:text="O Mágico de Oz" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            </com.tiagohs.cinema_history.presentation.views.MaxWidthFrameLayout>

            <!-- ===== Outras áreas ===== -->

            <TextView
                android:id="@+id/exploreTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_section_spacing"
                android:paddingStart="@dimen/home_screen_padding"
                android:paddingEnd="@dimen/home_screen_padding"
                android:text="@string/home_section_explore_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/destinationsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/home_destination_list_padding"
                android:paddingEnd="@dimen/home_destination_list_padding"
                tools:itemCount="4"
                tools:listitem="@layout/adapter_home_destination" />

            <!-- ===== Consulta / app ===== -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_section_spacing"
                android:paddingStart="@dimen/home_screen_padding"
                android:paddingEnd="@dimen/home_screen_padding"
                android:text="@string/home_section_more_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <com.tiagohs.cinema_history.presentation.views.MaxWidthFrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ls_maxWidth="@dimen/ls_list_max_width">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CinemaHistory.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/home_screen_padding"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="@dimen/home_screen_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/glossaryRow"
                        layout="@layout/view_home_link_row" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dividerInsetStart="72dp" />

                    <include
                        android:id="@+id/referencesRow"
                        layout="@layout/view_home_link_row" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dividerInsetStart="72dp" />

                    <include
                        android:id="@+id/settingsRow"
                        layout="@layout/view_home_link_row" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dividerInsetStart="72dp" />

                    <include
                        android:id="@+id/aboutRow"
                        layout="@layout/view_home_link_row" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            </com.tiagohs.cinema_history.presentation.views.MaxWidthFrameLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/loadView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone"
        app:shimmer_duration="800">

        <include
            android:id="@+id/loadHome"
            layout="@layout/load_home" />

    </com.facebook.shimmer.ShimmerFrameLayout>

    <include
        android:id="@+id/errorContainer"
        layout="@layout/view_error" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
