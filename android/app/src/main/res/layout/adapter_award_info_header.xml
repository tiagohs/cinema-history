<?xml version="1.0" encoding="utf-8"?>
<!-- Ficha do prêmio na aba "Sobre": logo, quem entrega, país, primeira cerimônia e redes. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/awards_screen_padding"
    android:paddingTop="20dp"
    android:paddingEnd="@dimen/awards_screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/infoLogo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.CinemaHistory.Awards.Circle"
            app:strokeColor="@color/awards_gold"
            app:strokeWidth="2dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/infoName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/oswald_regular"
                android:textColor="@color/awards_on_surface"
                android:textSize="22sp"
                tools:text="Oscar" />

            <TextView
                android:id="@+id/infoPresentedBy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/awards_on_surface_variant"
                android:textSize="13sp"
                tools:text="Academia de Artes e Ciências Cinematográficas" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/infoMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/awards_on_surface_muted"
        android:textSize="13sp"
        tools:text="Estados Unidos · Primeira cerimônia: 16 de maio de 1929" />

    <LinearLayout
        android:id="@+id/infoSocial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-8dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/siteImage"
            style="@style/Widget.CinemaHistory.Awards.SocialButton"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_link_grey_dark_24dp" />

        <ImageButton
            android:id="@+id/facebookImage"
            style="@style/Widget.CinemaHistory.Awards.SocialButton"
            android:contentDescription="Facebook"
            app:srcCompat="@drawable/ic_facebook_grey" />

        <ImageButton
            android:id="@+id/twitterImage"
            style="@style/Widget.CinemaHistory.Awards.SocialButton"
            android:contentDescription="X"
            app:srcCompat="@drawable/ic_twitter_grey" />

        <ImageButton
            android:id="@+id/instagramImage"
            style="@style/Widget.CinemaHistory.Awards.SocialButton"
            android:contentDescription="Instagram"
            app:srcCompat="@drawable/ic_instagram_grey" />

        <ImageButton
            android:id="@+id/youtubeImage"
            style="@style/Widget.CinemaHistory.Awards.SocialButton"
            android:contentDescription="YouTube"
            app:srcCompat="@drawable/ic_logo_youtube" />

    </LinearLayout>

    <TextView
        style="@style/TextAppearance.CinemaHistory.Awards.Kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/award_about_title"
        android:textColor="@color/awards_gold" />

</LinearLayout>
