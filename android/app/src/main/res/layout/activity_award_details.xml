<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela de prêmios (tema escuro, estilo streaming):
    - hero do ano selecionado (backdrop/pôster do vencedor principal) que faz parallax ao rolar;
    - toolbar transparente que ganha fundo conforme o hero recolhe;
    - abas (Indicados e vencedores / Sobre) presas logo abaixo da toolbar.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/awards_background"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:background="@color/awards_background"
        android:fitsSystemWindows="true"
        android:stateListAnimator="@null"
        android:theme="@style/AppTheme.AppBarOverlay"
        app:elevation="0dp"
        tools:alpha="1">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/awards_hero_height"
            android:background="@color/awards_background"
            android:fitsSystemWindows="true"
            app:contentScrim="@null"
            app:statusBarScrim="@null"
            app:titleEnabled="false"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <!-- Imagens do hero: duas camadas para o crossfade entre anos -->
            <FrameLayout
                android:id="@+id/heroImages"
                android:fitsSystemWindows="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.5">

                <ImageView
                    android:id="@+id/heroImageBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/heroImageFront"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/img_ben_hur" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/awards_hero_scrim_start" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/awards_hero_top_scrim"
                    android:layout_gravity="top"
                    android:background="@drawable/awards_hero_scrim_top" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/awards_hero_bottom_scrim"
                    android:layout_gravity="bottom"
                    android:background="@drawable/awards_hero_scrim_bottom" />

            </FrameLayout>

            <!-- Conteúdo do hero: sobe mais devagar que a imagem (parallax em camadas) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/heroContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:paddingStart="@dimen/awards_hero_padding"
                android:paddingEnd="@dimen/awards_hero_padding"
                android:paddingBottom="@dimen/awards_hero_padding"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.15">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/heroPosterCard"
                    android:layout_width="@dimen/awards_hero_poster_width"
                    android:layout_height="@dimen/awards_hero_poster_height"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/awards_surface_high"
                    app:cardCornerRadius="@dimen/awards_card_radius"
                    app:cardElevation="@dimen/awards_winner_glow"
                    app:strokeColor="@color/awards_gold"
                    app:strokeWidth="@dimen/awards_winner_stroke"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:id="@+id/heroPoster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/awardLogo"
                    android:layout_width="@dimen/awards_logo_size"
                    android:layout_height="@dimen/awards_logo_size"
                    android:background="@color/md_white_1000"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    app:contentPadding="5dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.CinemaHistory.Awards.Circle"
                    app:strokeColor="@color/awards_gold"
                    app:strokeWidth="1dp"
                    app:layout_constraintBottom_toTopOf="@id/heroYear"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/awardLabel"
                    style="@style/TextAppearance.CinemaHistory.Awards.Kicker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="12dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/awards_gold"
                    app:layout_constraintBottom_toBottomOf="@id/awardLogo"
                    app:layout_constraintEnd_toStartOf="@id/heroPosterCard"
                    app:layout_constraintStart_toEndOf="@id/awardLogo"
                    app:layout_constraintTop_toTopOf="@id/awardLogo"
                    tools:text="Oscar" />

                <TextView
                    android:id="@+id/heroYear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="@font/oswald_bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/awards_on_surface"
                    android:textSize="@dimen/awards_hero_year_size"
                    app:layout_constraintBottom_toTopOf="@id/heroTitle"
                    app:layout_constraintEnd_toStartOf="@id/heroPosterCard"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="2026" />

                <TextView
                    android:id="@+id/heroTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/oswald_regular"
                    android:maxLines="2"
                    android:textColor="@color/awards_on_surface"
                    android:textSize="@dimen/awards_hero_title_size"
                    app:layout_constraintBottom_toTopOf="@id/heroWinnerLabel"
                    app:layout_constraintEnd_toStartOf="@id/heroPosterCard"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="Uma Batalha Após a Outra" />

                <TextView
                    android:id="@+id/heroWinnerLabel"
                    style="@style/TextAppearance.CinemaHistory.Awards.Kicker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="12dp"
                    android:drawablePadding="6dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textColor="@color/awards_gold"
                    app:drawableStartCompat="@drawable/ic_awards_trophy_16dp"
                    app:drawableTint="@color/awards_gold"
                    app:layout_constraintBottom_toTopOf="@id/heroMeta"
                    app:layout_constraintEnd_toStartOf="@id/heroPosterCard"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="Vencedor — Melhor Filme" />

                <TextView
                    android:id="@+id/heroMeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="12dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/awards_on_surface_variant"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toTopOf="@id/heroDetailsButton"
                    app:layout_constraintEnd_toStartOf="@id/heroPosterCard"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="Paul Thomas Anderson · 24 categorias · 125 indicados" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/heroDetailsButton"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="40dp"
                    android:text="@string/award_details_button"
                    android:textColor="@color/md_black_1000"
                    app:backgroundTint="@color/md_white_1000"
                    app:icon="@drawable/ic_awards_info_24dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/md_black_1000"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Fundo da toolbar (inclui a área da status bar): alpha acompanha o recolhimento do hero -->
            <View
                android:id="@+id/toolbarBackground"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:layout_gravity="top"
                android:alpha="0"
                android:background="@color/awards_background"
                android:fitsSystemWindows="true"
                app:layout_collapseMode="pin" />

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:fitsSystemWindows="false"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/AppTheme.PopupOverlay">

                <TextView
                    android:id="@+id/toolbarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0"
                    android:ellipsize="end"
                    android:fontFamily="@font/oswald_regular"
                    android:maxLines="1"
                    android:textColor="@color/awards_on_surface"
                    android:textSize="20sp"
                    tools:alpha="1"
                    tools:text="Oscar · 2026" />

            </com.google.android.material.appbar.MaterialToolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            style="@style/Widget.CinemaHistory.TabLayout.Awards"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tabbar_height" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/awards_background"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
        tools:alpha="1" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loadView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/awards_gold"
        app:trackColor="@color/awards_surface_high" />

    <include android:id="@+id/errorContainer" layout="@layout/view_error" />

    <include android:id="@+id/screenBlocked" layout="@layout/view_screen_blocked" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
