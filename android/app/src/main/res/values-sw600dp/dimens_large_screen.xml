    <dimen name="ls_text_max_width">680dp</dimen>
    <dimen name="ls_list_side_padding">8dp</dimen>

    <item name="ls_media_height_scale" format="float" type="dimen">1.5</item>

    <!-- ===== Home (dimens_home.xml) ===== -->
    <dimen name="home_screen_padding">24dp</dimen>
    <dimen name="home_hero_content_padding">24dp</dimen>
    <dimen name="home_hero_max_height">640dp</dimen>
